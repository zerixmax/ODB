generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id             String      @id @default(cuid())
  domain         String      // Glavna domena (npr. "marcopolosport.com") - mora biti editabilno
  altDomains     String?     // Alternativne/dodatne domene (npr. "mokalo.hr / wifi-korcula.com")
  client         String      // Naziv klijenta (npr. "Marko Polo Sport") - mora biti editabilno
  techStack      String      // npr. "Astro, Payload CMS", "Next.js"
  projectType    String      @default("WEB") // "WEB", "HARDWARE_IOT", "MAINTENANCE"

  // Hosting infrastruktura
  hosting        String      @default("VPS") // "VPS" ili "TOTOHOST"
  isVps          Boolean     @default(true) // Izvedeni pokazatelj iz hostinga
  cpanelUser     String?     // Korisničko ime na cPanelu (npr. "pontacom", "gmkorcul")
  diskUsageMb    Int?        // Zauzeće diska u MB iz WHM-a

  currentStatus  String      // Opis faze rada (npr. "Funkcionalni test na VPS aktivan")
  stage          String      @default("IN_PROGRESS") // "BACKLOG", "IN_PROGRESS", "WAITING_VPS", "PRODUCTION", "MAINTENANCE"
  priority       String      @default("NORMAL")      // "URGENT", "HIGH", "NORMAL", "LOW"
  progress       Int         @default(0)             // 0 - 100 %

  // Razdvojene financije
  devPrice       Float?      @default(0.0) // Cijena izrade ili redizajna (€)
  isDevPaid      Boolean     @default(false) // Je li izrada plaćena
  hostingPrice   Float?      @default(0.0) // Godišnja naknada za hosting/domenu (€)
  isHostingPaid  Boolean     @default(false) // Je li hosting plaćen

  // Vremenski markeri (Lifecycle)
  setupDate      DateTime?   // Datum prvog setupa na serveru (točan DateTime)
  deadlineDate   DateTime?   // Rok isporuke projekta
  lastUpdateDate DateTime    @default(now()) // Datum zadnjeg commit-a / rada

  // Dokumentacija i detaljne opaske
  docUrl         String?     // Link na Google Docs / Drive specifikaciju
  isArchived     Boolean     @default(false)
  notes          String?     // Markdown/tekst za interne konfiguracije, portove, bilješke

  // Algorand ASA integracija (samo za detaljni prikaz, NE na dashboard pločici)
  asaId          String?     // Asset ID na Algorand blockchainu
  asaExplorerUrl String?     // Link na explorer (npr. Allo, Pera Explorer)

  // Okruženje i automatizacija
  devDevice      String      @default("WORKSTATION") // "LAPTOP" ili "WORKSTATION"
  hasGitBackup   Boolean     @default(true)
  hasCicd        Boolean     @default(false)         // Je li aktivan Coolify webhook

  timeLogs       TimeLog[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model PotentialLead {
  id             String      @id @default(cuid())
  title          String      // Radni naziv projekta (npr. "Web shop uljara")
  clientName     String      // Kontakt osoba / naziv OPG-a
  estimatedValue Float?      // Procijenjeni iznos posla (€)
  probability    Int         @default(50) // Vjerojatnost realizacije (0 - 100 %)
  status         String      @default("INQUIRY") // "INQUIRY", "PROPOSAL_SENT", "NEGOTIATION", "WON", "LOST"
  notes          String?     // Bilješke s inicijalnog razgovora
  targetDate     DateTime?   // Očekivani početak radova
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model TimeLog {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hours       Float       // decimalni sati, npr. 1.5
  description String?     // npr. "Konfiguracija Nginx proxyja i SSL certifikata"
  createdAt   DateTime    @default(now())
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}